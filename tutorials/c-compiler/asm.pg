grammar 'Asm';

# x86-64 assembly (AT&T syntax), the subset emitted for stages 1-5.
# Grows stage by stage alongside c.pg.
#
# Design notes:
# - Sort names deliberately avoid CParser's (Program, Function, Statement,
#   StatementList, Exp, Ident): both generated parsers are imported into the
#   same compiler modules.
# - Newlines are plain whitespace: the instruction subset is unambiguous
#   without line structure, so quasi-quotes can be laid out freely and the
#   emitter adds the conventional formatting back.
# - '$' immediates coexist with $-antiquotes: real immediates are always
#   numeric ($2), antiquote names always start with a letter ($src), and the
#   longest lexer match keeps them apart.

# Leading labels (AsmUnit:, Globl:, ...) name the generated AST constructors;
# see the matching note in c.pg. Names are kept distinct from c.pg's so both
# generated parsers can be imported unqualified into the compiler modules.

Asm = AsmUnit: AsmItems ;

# AsmItems must be normalized BEFORE AsmItem: RTK allows one anti-quote shape
# per AST type (scalar or list), and we want the list shape for AsmItem
# ($items :: [AsmItem]).
@shortcuts(items)
AsmItems = AsmItem* ;

AsmItem = Globl: '.globl' AsmId
        | Label: AsmId ':'
        | Movl: 'movl' Operand ',' Operand
        | Negl: 'negl' Operand
        | Notl: 'notl' Operand
        | Cmpl: 'cmpl' Operand ',' Operand
        | Sete: 'sete' Operand
        | Setne: 'setne' Operand
        | Setl: 'setl' Operand
        | Setle: 'setle' Operand
        | Setg: 'setg' Operand
        | Setge: 'setge' Operand
        | Addl: 'addl' Operand ',' Operand
        | Subl: 'subl' Operand ',' Operand
        | Imull: 'imull' Operand ',' Operand
        | Cdq: 'cdq'
        | Idivl: 'idivl' Operand
        | Push: 'push' Operand
        | Pop: 'pop' Operand
        | Je: 'je' AsmId
        | Jne: 'jne' AsmId
        | Jmp: 'jmp' AsmId
        | Movq: 'movq' Operand ',' Operand
        | Subq: 'subq' Operand ',' Operand
        | Ret: 'ret' ;

# A Mem operand is a stack slot: signed displacement off a base register, in the
# AT&T disp(base) form -- a local at -4(%rbp), or (later) an argument at 8(%rbp).
@shortcuts(src, dst)
Operand = Imm: '$' num
        | RegOp: Reg
        | Mem: num '(' Reg ')' ;

# %eax/%al are the 32- and 8-bit accumulators; %ecx the 32-bit second operand;
# push/pop work only at 64-bit width, so those registers also appear as
# %rax/%rcx; %rbp/%rsp are the 64-bit frame and stack pointers. The emitter
# just prints whichever name the AST carries.
Reg = Eax: '%eax'
    | Al: '%al'
    | Ecx: '%ecx'
    | Rax: '%rax'
    | Rcx: '%rcx'
    | Rbp: '%rbp'
    | Rsp: '%rsp' ;

@shortcuts(sym)
AsmId = Sym: asmid ;

# ----------------------------------------------------------------------------
# Lexical rules
# ----------------------------------------------------------------------------

asmid = [a-zA-Z_][a-zA-Z_0-9]* ;
# num is signed: stack displacements can be negative (-4(%rbp)). It reads as an
# Int, so the '-' is part of the number, not a separate operator token.
Int: num = '-'? [0-9]+ ;
Ignore: ws = [ \t\n\r]+ ;
