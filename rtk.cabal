Cabal-Version:       2.2
Name:                rtk
Version:             0.10
Synopsis:            Parser and rewrite facility generator from grammar specifications
Description:         RTK (Rewrite ToolKit) generates Alex lexer and Happy parser
                     files from grammar specifications. It supports quasi-quotation
                     for embedding parsed syntax in Haskell code.
License:             MIT
License-File:        LICENSE
Author:              prozak
Maintainer:          nickolay.lysenko@gmail.com
Homepage:            https://github.com/prozak/rtk
Bug-Reports:         https://github.com/prozak/rtk/issues
Category:            Language, Development
Build-Type:          Simple
Tested-With:         GHC == 9.4.7

Extra-Source-Files:
    CHANGELOG.md
    README.md
    test-grammars/*.pg

Source-Repository head
    Type:     git
    Location: https://github.com/prozak/rtk.git

Library
  Exposed-Modules: 
                   Lexer,
                   Parser,
                   Grammar
  Build-Depends:     base >= 4.7 && < 5, array, syb, template-haskell, containers, mtl, pretty, pretty-show, MissingH, haskell-src-exts, haskell-src-meta, lens
  Default-Language: Haskell2010
  Default-Extensions:  DeriveDataTypeable
  ghc-options:       -Wall -Wunused-imports -Wunused-top-binds -Wunused-local-binds -Wunused-matches

Executable rtk
  Main-is:           main.hs
  Build-Depends:     base >= 4.7 && < 5, array, syb, template-haskell, containers, mtl, pretty, pretty-show, MissingH, haskell-src-exts, haskell-src-meta, lens, HUnit, optparse-applicative, time, ansi-terminal
  Build-Tool-Depends: happy:happy, alex:alex
  Other-Modules:
                     Lexer,
                     Parser,
                     TokenProcessing,
                     Grammar,
                     GenAST,
                     GenQ,
                     GenX,
                     GenY,
                     GenPP,
                     Normalize,
                     PrintGrammar,
                     StrQuote,
                     StringLiterals,
                     DebugOptions,
                     Debug
  Default-Language: Haskell2010
  Default-Extensions: DeriveDataTypeable
  ghc-options:       -rtsopts -Wall -Wunused-imports -Wunused-top-binds -Wunused-local-binds -Wunused-matches
