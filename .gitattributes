# Golden test snapshots are regenerated by `make accept-golden`. Mark them as
# generated so GitHub collapses them in PR diffs by default and excludes them
# from language statistics (they stay fully diffable on demand).
test/golden/** linguist-generated=true

# Java lexer token-stream goldens are regenerated by `make accept-lex-java`.
test-grammars/java/lexical/*.tokens linguist-generated=true
